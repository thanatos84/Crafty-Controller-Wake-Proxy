# Crafty Controller Wake Proxy - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit your actual '.env' file to Git!

# Full HTTPS/HTTP URL of your Crafty Controller web panel (e.g., HTTPS on port 8443)
CRAFTY_URL=https://192.168.1.100:8443

# Crafty API Bearer token (obtained from User Icon > Account Settings > API Keys)
# Keep this secure!
API_TOKEN=your_crafty_api_jwt_token_here

# UUID of the Minecraft server in Crafty (obtained from the browser URL when viewing server details)
SERVER_ID=your_minecraft_server_uuid_here

# Local IP or hostname of the host where Crafty runs the Minecraft server port (e.g. 192.168.1.100 or 127.0.0.1)
TARGET_HOST=127.0.0.1

# Internal port where Crafty runs the Minecraft server (e.g., 25602)
INTERNAL_PORT=25602

# Public/external port where this proxy listens for incoming connections (e.g., 25565 or 25600)
LISTEN_PORT=25600

# Idle time in seconds before stopping the server due to inactivity (e.g., 600 = 10 minutes)
IDLE_TIMEOUT_SECONDS=600
